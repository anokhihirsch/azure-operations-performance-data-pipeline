import dlt
from pyspark.sql import functions as F

# COMMAND ----------

# 1. Storage path

storage_account = "operationsperformace"

silver_orders_path = f"abfss://silver@{storage_account}.dfs.core.windows.net/orders/"

# COMMAND ----------

# 2. Data quality rules

orders_rules = {
    "order_id_is_not_null": "order_id IS NOT NULL",
    "customer_id_is_not_null": "customer_id IS NOT NULL",
    "order_date_is_not_null": "order_date IS NOT NULL",
    "order_amount_is_not_null": "order_amount IS NOT NULL"
}

# COMMAND ----------

# 3. Gold Table 1: Clean order-level table

@dlt.table(
    name="gold_orders_clean",
    comment="Clean order-level operational data prepared for reporting."
)
@dlt.expect_all_or_drop(orders_rules)
def gold_orders_clean():
    df = (
        spark.readStream
        .format("delta")
        .load(silver_orders_path)
    )

    return df

# COMMAND ----------

# 4. Gold Table 2: Daily operations KPI table

@dlt.table(
    name="gold_daily_operations_kpi",
    comment="Daily operations KPIs including order volume, revenue, shipped orders, and late orders."
)
def gold_daily_operations_kpi():
    df = dlt.read("gold_orders_clean")

    return (
        df.groupBy("order_date")
        .agg(
            F.count("order_id").alias("total_orders"),
            F.round(F.sum("order_amount"), 2).alias("total_revenue"),
            F.sum("is_shipped").alias("shipped_orders"),
            F.sum("is_late").alias("late_orders"),
            F.round(F.avg("days_to_ship"), 2).alias("avg_days_to_ship"),
            F.round(F.avg("days_late_vs_promise"), 2).alias("avg_days_late_vs_promise")
        )
    )

# COMMAND ----------

# 5. Gold Table 3: Delivery performance by shipping org

@dlt.table(
    name="gold_delivery_performance",
    comment="Delivery performance metrics by ship organization and order status."
)
def gold_delivery_performance():
    df = dlt.read("gold_orders_clean")

    return (
        df.groupBy("ship_org", "order_status")
        .agg(
            F.count("order_id").alias("total_orders"),
            F.sum("is_shipped").alias("shipped_orders"),
            F.sum("is_late").alias("late_orders"),
            F.round(F.avg("days_to_ship"), 2).alias("avg_days_to_ship"),
            F.round(F.avg("days_late_vs_promise"), 2).alias("avg_days_late_vs_promise")
        )
    )

# COMMAND ----------

# 6. Gold Table 4: Customer order summary

@dlt.table(
    name="gold_customer_order_summary",
    comment="Customer-level order, revenue, and late shipment summary."
)
def gold_customer_order_summary():
    df = dlt.read("gold_orders_clean")

    return (
        df.groupBy("customer_id")
        .agg(
            F.count("order_id").alias("total_orders"),
            F.round(F.sum("order_amount"), 2).alias("total_revenue"),
            F.sum("is_late").alias("late_orders"),
            F.round(F.avg("days_to_ship"), 2).alias("avg_days_to_ship")
        )
    )

# COMMAND ----------

# 7. Gold Table 5: Late order detail table

@dlt.table(
    name="gold_late_order_detail",
    comment="Detailed late order records for operational follow-up."
)
def gold_late_order_detail():
    df = dlt.read("gold_orders_clean")

    return (
        df
        .filter(F.col("is_late") == 1)
        .select(
            "order_id",
            "customer_id",
            "order_date",
            "promise_date",
            "actual_ship_date",
            "ship_org",
            "order_status",
            "order_amount",
            "days_to_ship",
            "days_late_vs_promise",
            "is_late"
        )
    )
